{
  "name": "global-vibez-dsg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash ./scripts/dev-up.sh",
    "dev:frontend": "cd source/web-assets/frontend && ESLINT_NO_DEV_ERRORS=true BROWSER=none yarn start",
    "dev:docker": "bash ./scripts/dev-up.sh --docker",
    "build": "cd source/web-assets/frontend && DISABLE_ESLINT_PLUGIN=true yarn build",
    "start": "npm run dev:frontend",
    "backend": "cd source/web-assets/backend && . .venv/bin/activate && DISABLE_BG_SCHEDULERS=1 uvicorn server:app --host 0.0.0.0 --port 8001",
    "typecheck": "cd source/web-assets/frontend && yarn typecheck",
    "lint": "npm run typecheck",
    "smoke": "bash ./scripts/smoke-test.sh https://www.globalvibezdsg.com",
    "smoke:full": "SMOKE_REQUIRE_API=1 bash ./scripts/smoke-test.sh https://www.globalvibezdsg.com \"${REACT_APP_BACKEND_URL:-https://globalvibezdsg1-production.up.railway.app}\"",
    "sync:workspace": "bash ./scripts/sync-workspace.sh main",
    "sync:verify": "git fetch origin --prune && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\" && echo 'Workspace matches origin/main'",
    "sync:guards:install": "bash ./scripts/setup-sync-guards.sh"
  },
  "dependencies": {},
  "devDependencies": {}
}
