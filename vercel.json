{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "yarn --cwd source/web-assets/frontend install --frozen-lockfile",
  "builds": [
    {
      "src": "source/web-assets/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "copilot/add-domains-in-vercel-setup": false
    }
  },
  "alias": [
    "globalvibezdsg.com",
    "www.globalvibezdsg.com"
  ]
}
