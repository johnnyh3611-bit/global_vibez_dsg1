{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm --prefix source/web-assets/frontend install --legacy-peer-deps",
  "buildCommand": "npm --prefix source/web-assets/frontend run build",
  "outputDirectory": "source/web-assets/frontend/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "copilot/add-domains-in-vercel-setup": false
    }
  },
  "alias": [
    "globalvibezdsg.com",
    "www.globalvibezdsg.com"
  ]
}
