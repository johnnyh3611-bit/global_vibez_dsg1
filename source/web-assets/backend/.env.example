# Global Vibez — Backend environment variables (source/web-assets/backend)
#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Only the three vars in "REQUIRED" are enforced at boot (see scripts/check-env.js);
# everything else is optional and gates a specific feature/integration.
# Run `uvicorn server:app` after configuring. Health: GET /api/health (also /health).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED (enforced by scripts/check-env.js)
# ─────────────────────────────────────────────────────────────────────────────
# JWT signing secret — use a long random value: `openssl rand -hex 32`.
# Boot logs SECURITY warnings on missing/known-weak values.
JWT_SECRET=change-me-use-openssl-rand-hex-32
# MongoDB connection string.
MONGO_URL=mongodb://localhost:27017
# MongoDB database name.
DB_NAME=global_vibez

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION / SERVER
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=False                      # "true" enables debug mode
HOST=0.0.0.0
PORT=8001
# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# Public URLs used to build links in emails/redirects.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001
# REACT_APP_FRONTEND_URL is accepted as a fallback for FRONTEND_URL.
# REACT_APP_FRONTEND_URL=http://localhost:3000
# Set to 1 in dev/CI to skip ~25 background scheduler workers.
DISABLE_BG_SCHEDULERS=0
# Set to 1 to disable only the Card Royale scheduler.
DISABLE_CARD_ROYALE_SCHEDULER=0
# Toggle rate-limiting middleware.
RATE_LIMIT_ENABLED=false
# Redis for multi-replica Socket.IO + optional caching (in-process manager when unset).
REDIS_URL=redis://localhost:6379
# Set on Railway; marks the process as running in a Railway environment.
# RAILWAY_ENVIRONMENT=production
# Legacy alias for ENVIRONMENT ("production" toggles prod behavior).
# ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN / SECURITY
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@globalvibez.com,founder@globalvibez.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_SECRET=change-me-admin-session-secret
# Founder TOTP 2FA secret (base32).
FOUNDER_2FA_SECRET=JBSWY3DPEHPK3PXP
FOUNDER_EMAIL=founder@globalvibez.com
# Allow weak/default secrets outside production (dev convenience only).
ALLOW_WEAK_SECRETS=0
# HMAC signing key for the Vibe Fleet ELD tamper-evident log hash chain.
ELD_SIGNING_KEY=change-me-eld-signing-key-production
# HMAC secret for Vibe Spot verification (v4 closeout).
VIBE_SPOT_HMAC_SECRET=change-me-vibe-spot-hmac
# HMAC secret for content-rights / DMCA tokens.
CONTENT_RIGHTS_SECRET=change-me-content-rights
# VR handshake / handover HMAC secrets.
VR_HANDSHAKE_SECRET=change-me-vr-handshake
GAME_HANDSHAKE_TTL=30
VANISHING_MESSAGE_TTL_SECONDS=86400

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE — RETIRED / NOT used for payments (card rail is Helio, coin rail is Solana)
# ─────────────────────────────────────────────────────────────────────────────
# Stripe is retired for payments: legacy Stripe checkout routes return 410 Gone
# (see services/stripe_retired.py). Leave these UNSET — do NOT provision them for
# coin top-up / wallet card checkout (matches ENV_VARIABLES.md and GO_LIVE.md).
# STRIPE_API_KEY stays in config/settings.py only as a backward-compat shim.
# STRIPE_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# AGE VERIFICATION (Stripe Identity) — NOT a payment rail
# ─────────────────────────────────────────────────────────────────────────────
# Webhook secret for Stripe Identity age-verification events. When set, the KYC
# vendor webhook in routes/age_verification.py becomes public and verifies the
# Stripe-Signature header; leave unset to use the admin-gated stub mode.
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_your_stripe_identity_webhook_secret

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM (Google Gemini)
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini powers the date planner, coaches, matching, practice, translation.
# Get a key: https://aistudio.google.com/apikey (GOOGLE_API_KEY accepted as alias).
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_google_api_key
# Legacy alias only — kept for backward-compat; resolves to the Gemini key in
# config/settings.py. Set GEMINI_API_KEY instead and leave this unset.
# EMERGENT_LLM_KEY=
# OpenAI — Voice Mirror / Voice Coach STT+TTS (Whisper + tts-1).
OPENAI_API_KEY=your_openai_api_key
# ElevenLabs — AI voice generation.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# mem0 — long-term memory service.
MEM0_API_KEY=your_mem0_api_key
MEM0_USER_ID=your_mem0_user_id

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend) & NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key
RESEND_SENDER_EMAIL=onboarding@resend.dev
# Legacy alias for the sender address in staff routes.
RESEND_FROM=onboarding@resend.dev
DIGEST_RECIPIENT_EMAIL=digest@globalvibez.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
PERF_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Firebase service account JSON (as a single-line string) for push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# AUTH PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
# Privy social login — JWT verified via JWKS (PRIVY_JWKS_URL derived from app id when unset).
PRIVY_APP_ID=your_privy_app_id
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/your_privy_app_id/jwks.json
# WebAuthn (rewards queue admin approvals).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_ADMIN_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# REAL-TIME MEDIA (Agora, Daily, Cloudflare Stream)
# ─────────────────────────────────────────────────────────────────────────────
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
# Daily.co — Speed Dating video rooms.
DAILY_API_KEY=your_daily_api_key
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_stream_api_token
CLOUDFLARE_STREAM_SUBDOMAIN=customer-xxxxx.cloudflarestream.com
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your_cloudflare_stream_webhook_secret

# ─────────────────────────────────────────────────────────────────────────────
# TELEPHONY (Twilio)
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
TWILIO_SOS_CONTACT=+1234567890

# ─────────────────────────────────────────────────────────────────────────────
# MAPS / RIDES / VEHICLE INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
MAPBOX_API_KEY=your_mapbox_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
# Smartcar — connected-vehicle integration.
SMARTCAR_CLIENT_ID=your_smartcar_client_id
SMARTCAR_CLIENT_SECRET=your_smartcar_client_secret
SMARTCAR_REDIRECT_URI=http://localhost:8001/api/integrations/smartcar/callback
SMARTCAR_MODE=test
# Spotify — music integration.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8001/api/integrations/spotify/callback
# RapidAPI — sports data for the Sports Lounge.
RAPIDAPI_SPORTS_KEY=your_rapidapi_sports_key

# ─────────────────────────────────────────────────────────────────────────────
# SOLANA / CRYPTO / TOKEN (Vibez Coin, payouts, TGE)
# ─────────────────────────────────────────────────────────────────────────────
GLOBAL_VIBEZ_SOLANA_RECEIVE_WALLET=YourSolanaTreasuryPubkey
SOLANA_RECEIVE_WALLET=YourSolanaTreasuryPubkey
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_UNLOCKED=false
VIBEZ_SOLANA_RPC=https://api.mainnet-beta.solana.com
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
# Helio / MoonPay Commerce — card rail for coin packs + Founder Chair vault.
HELIO_PAYLINK_ID=your_dynamic_paylink_id
HELIO_NETWORK=test                # main | test | dev | devnet
HELIO_WEBHOOK_TOKEN=shared_token_from_helio_webhook_create
# Vibez token mint / treasury.
VIBEZ_TOKEN_MINT_ADDRESS=YourTokenMintAddress
VIBEZ_TREASURY_SECRET=your_treasury_keypair_secret
VIBEZ_TOKEN_DECIMALS=9
VIBEZ_CONFIRMATION=confirmed
VIBEZ_MINT_MODE=simulate
VIBEZ_USD_PRICE=0.001
# TGE (token generation event).
VIBEZ_TGE_MODE=simulate
VIBEZ_TGE_MIN_BALANCE=0
# USDC driver payouts daemon (all optional; safe simulation defaults).
VIBEZ_PAYOUT_DRY_RUN=1
VIBEZ_PAYOUT_NETWORK=devnet
VIBEZ_PAYOUT_WALLET_PUBKEY=
VIBEZ_PAYOUT_WALLET_SECRET=
VIBEZ_PAYOUT_USDC_MINT=
VIBEZ_PAYOUT_USDC_DECIMALS=6
VIBEZ_PAYOUT_BATCH_SIZE=10
VIBEZ_PAYOUT_MAX_ATTEMPTS=3
VIBEZ_PAYOUT_MAX_PER_TX_USD=100
VIBEZ_PAYOUT_MAX_PER_DRIVER_DAY_USD=500
VIBEZ_PAYOUT_POLL_SECONDS=30
VIBEZ_PAYOUT_ORPHAN_TIMEOUT_SEC=300
# Streamflow — token vesting/streaming.
STREAMFLOW_CLUSTER=devnet
STREAMFLOW_TREASURY_WALLET=

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS BETA GATE / AUDIT
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_BETA_MODE=true
PAYMENT_BETA_ALLOWLIST=alice@example.com,bob@example.com
PAYMENT_SUPPORT_EMAIL=payments-beta@globalvibezdsg.com
PAYMENT_SUPPORT_DISCORD=https://discord.gg/globalvibez
SUPPORT_EMAIL=support@globalvibez.com
SUPPORT_DISCORD_URL=https://discord.gg/globalvibez
PAYMENTS_REQUIRE_WEBHOOK_AUTH=0
PAYMENTS_ALERT_RECIPIENT_EMAIL=payments-alerts@globalvibez.com
PAYMENTS_DRIFT_THRESHOLD_USD=100
PAYMENTS_DRIFT_WINDOW_DAYS=7
PAYMENTS_DRIFT_COOLDOWN_HOURS=24
PAYMENTS_DRIFT_TICK_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# PRICING / REWARDS / BUSINESS RULES (optional tuning knobs)
# ─────────────────────────────────────────────────────────────────────────────
PREMIUM_BASE_PRICE_USD=9.99
PREMIUM_PRICE_STEP_USD=1.00
PROFIT_SHARE_RATIO=0.7
PROFIT_SHARE_DEMO_PROFIT=1000
HIGH_ROLLER_REF_BONUS_DAYS=7
REWARDS_ALERT_THRESHOLD=1000
MERCHANT_DSG_TV_FLIGHT_USD=250
MERCHANT_PUSH_BLAST_USD=50
MERCHANT_REFERRAL_REWARD_EVERY=5
VIBE_DRIVE_DAILY_CAP=100
VIBE_DRIVE_MILES_PER_VIBEZ=1
VIBE_VENUES_PLATFORM_FEE_PCT=10
VIBE_VENUES_PREP_FEE_PCT=5
SMARTSTACK_MAX_DETOUR_MI=5
SMARTSTACK_MIN_PROFIT_BOOST=0.1
RESET_TOKEN_TTL_MINUTES=30
BETA_TESTER_PASSWORD=change-me-beta-tester-password

# ─────────────────────────────────────────────────────────────────────────────
# TEST / FEATURE MODE FLAGS (leave unset outside dev)
# ─────────────────────────────────────────────────────────────────────────────
CHAIRS_TEST_MODE=0
FOUNDERS_PASS_TEST_MODE=0
BEAT_DLC_MINT_MODE=simulate
SOVEREIGN_OPS_DRY_RUN=1
VR_PHYSICAL_MODE=off
APEX_EVOLUTION_TIMESTAMP=

# ─────────────────────────────────────────────────────────────────────────────
# DMCA DESIGNATED AGENT (content rights registration metadata)
# ─────────────────────────────────────────────────────────────────────────────
DMCA_AGENT_NAME=
DMCA_AGENT_EMAIL=
DMCA_AGENT_PHONE=
DMCA_AGENT_ADDRESS=
DMCA_AGENT_REGISTRATION_DATE=
DMCA_AGENT_PAYGOV_TRACKING_ID=

# ─────────────────────────────────────────────────────────────────────────────
# PATHS / STORAGE
# ─────────────────────────────────────────────────────────────────────────────
# Directory for uploaded media (defaults to a repo-local path when unset).
UPLOADS_DIR=
# SQLite dir for the AI Judge module.
AI_JUDGE_DB_DIR=
