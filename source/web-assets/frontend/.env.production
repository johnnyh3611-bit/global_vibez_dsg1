# Production build defaults for CRA (Vercel / Azure static).
# REACT_APP_* must be present at build time or webpack inlines `undefined`,
# which crashes eager imports that call `.replace` on the backend URL.
#
# Override in the Vercel/Railway/Azure dashboard with the live FastAPI URL.
# Leave empty only for static-only previews — UI will render, API calls no-op.
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=https://www.globalvibezdsg.com
