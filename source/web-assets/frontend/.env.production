# Production build defaults for CRA (Vercel / Azure static).
# REACT_APP_* must be present at build time or webpack inlines `undefined`.
#
# Override in the Vercel dashboard only if the API host changes.
REACT_APP_BACKEND_URL=https://globalvibezdsg1-production.up.railway.app
REACT_APP_FRONTEND_URL=https://www.globalvibezdsg.com
# Privy social login (Google / X) — set the real app id in Vercel env;
# PrivyAuthProvider reads process.env.REACT_APP_PRIVY_APP_ID at bake time.
# REACT_APP_PRIVY_APP_ID=
