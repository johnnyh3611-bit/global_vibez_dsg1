{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "globalvibezdsg.com" }],
      "destination": "https://www.globalvibezdsg.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "global-vibez-dsg.vercel.app" }],
      "destination": "https://www.globalvibezdsg.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!static/|assets/|generators/|landing-tour/|videos/|unity-builds/|unity/|.*\\.(?:js|css|map|json|txt|xml|ico|png|jpg|jpeg|gif|svg|webp|mp3|mp4|webm|ogg|pdf|wasm|webmanifest|woff|woff2|ttf|eot)$).*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "DISABLE_ESLINT_PLUGIN": "true",
      "GENERATE_SOURCEMAP": "false",
      "CI": "false",
      "ESLINT_NO_DEV_ERRORS": "true"
    }
  }
}
