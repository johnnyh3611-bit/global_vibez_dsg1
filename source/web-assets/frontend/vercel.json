{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "globalvibezdsg.com" }],
      "destination": "https://www.globalvibezdsg.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "global-vibez-dsg.vercel.app" }],
      "destination": "https://www.globalvibezdsg.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!static/|assets/|generators/|landing-tour/|videos/|unity-builds/|unity/|.*\\.(?:[jJ][sS]|[cC][sS][sS]|[mM][aA][pP]|[jJ][sS][oO][nN]|[tT][xX][tT]|[xX][mM][lL]|[iI][cC][oO]|[pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[gG][iI][fF]|[sS][vV][gG]|[wW][eE][bB][pP]|[mM][pP]3|[mM][pP]4|[wW][eE][bB][mM]|[oO][gG][gG]|[pP][dD][fF]|[wW][aA][sS][mM]|[wW][eE][bB][mM][aA][nN][iI][fF][eE][sS][tT]|[wW][oO][fF][fF]|[wW][oO][fF][fF]2|[tT][tT][fF]|[eE][oO][tT])$).*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "DISABLE_ESLINT_PLUGIN": "true",
      "GENERATE_SOURCEMAP": "false",
      "CI": "false",
      "ESLINT_NO_DEV_ERRORS": "true"
    }
  }
}
